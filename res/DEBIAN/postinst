#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/trdesk/trdesk /usr/bin/trdesk

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/trdesk.service ]; then
			rm /etc/systemd/system/trdesk.service /usr/lib/systemd/system/trdesk.service /usr/lib/systemd/user/trdesk.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/trdesk/files/systemd/trdesk.service /usr/lib/systemd/system/trdesk.service
		# try fix error in Ubuntu 18.04
		# Failed to reload rustdesk.service: Unit rustdesk.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/trdesk.service:10: Executable path is not absolute: pkill -f "trdesk --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/trdesk.service
		fi
		systemctl daemon-reload
		systemctl enable trdesk
		systemctl start trdesk
	fi
fi
